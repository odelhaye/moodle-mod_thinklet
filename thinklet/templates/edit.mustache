{{!
    @template mod_thinklet/edit
    Block management and preview links.
}}
<h2>{{#str}}editthinklet, mod_thinklet{{/str}} : {{{title}}}</h2>
<div class="d-flex flex-wrap gap-2 mb-4">
    <a href="{{backurl}}" class="btn btn-outline-secondary thinklet-admin-outline">{{#str}}backtothinklet, mod_thinklet{{/str}}</a>
    <a href="{{previewallurl}}" class="btn btn-outline-secondary thinklet-admin-outline" target="_blank" rel="noopener noreferrer">{{#str}}previewall, mod_thinklet{{/str}}</a>
    <a href="{{previewexpandedurl}}" class="btn btn-outline-secondary thinklet-admin-outline" target="_blank" rel="noopener noreferrer">{{#str}}previewexpanded, mod_thinklet{{/str}}</a>
</div>
<h3>{{#str}}addblock, mod_thinklet{{/str}}</h3>
<div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:30px;">
    {{#addbuttons}}
        <a href="{{url}}" class="btn btn-primary thinklet-add-block-button"><svg width="18" height="18" viewBox="0 0 16 16" class="me-2" aria-hidden="true" focusable="false"><path d="{{icon}}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>{{label}}</a>
    {{/addbuttons}}
</div>
<h3>{{#str}}blocksstitle, mod_thinklet{{/str}}</h3>
{{^hasblocks}}
    <div class="alert alert-info">{{#str}}noblocks, mod_thinklet{{/str}}</div>
{{/hasblocks}}
{{#blocks}}
    <div class="card mb-3">
        <div class="card-body">
            <h5 style="margin-bottom:8px;"><span class="thinklet-number me-2">{{number}}</span>{{{title}}}</h5>
            <div style="color:#666;margin-bottom:15px;">{{type}}</div>
            <a href="{{editurl}}" class="btn btn-outline-primary btn-sm">{{#str}}edit, mod_thinklet{{/str}}</a>
            <a href="{{previewurl}}" class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener noreferrer">{{#str}}previewblock, mod_thinklet{{/str}}</a>
            <a href="{{upurl}}" class="btn btn-outline-secondary btn-sm">{{#str}}moveup, mod_thinklet{{/str}}</a>
            <a href="{{downurl}}" class="btn btn-outline-secondary btn-sm">{{#str}}movedown, mod_thinklet{{/str}}</a>
            <a href="{{deleteurl}}" class="btn btn-outline-danger btn-sm" data-thinklet-delete>{{#str}}delete, mod_thinklet{{/str}}</a>
        </div>
    </div>
{{/blocks}}
