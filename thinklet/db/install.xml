<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/thinklet/db" VERSION="2026102600" COMMENT="XMLDB file for mod_thinklet"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>

<TABLES>

<TABLE NAME="thinklet" COMMENT="Main table">

<FIELDS>
    <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
    <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
    <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
    <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
</FIELDS>

<KEYS>
    <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
</KEYS>

</TABLE>

<TABLE NAME="thinklet_blocks" COMMENT="Blocks composing the lab">

<FIELDS>
    <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
    <FIELD NAME="thinkletid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="type" TYPE="char" LENGTH="50" NOTNULL="true"/>
    <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="false"/>
    <FIELD NAME="content" TYPE="text" NOTNULL="false"/>
    <FIELD NAME="contentformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
    <FIELD NAME="optionsjson" TYPE="text" NOTNULL="false"/>
    <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
</FIELDS>

<KEYS>
    <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
    <KEY NAME="thinkletid" TYPE="foreign" FIELDS="thinkletid" REFTABLE="thinklet" REFFIELDS="id"/>
</KEYS>

<INDEXES>
    <INDEX NAME="thinkletid-sortorder" UNIQUE="false" FIELDS="thinkletid, sortorder"/>
</INDEXES>

</TABLE>

<TABLE NAME="thinklet_completed" COMMENT="Explicit learner completion of a Thinklet">
<FIELDS>
<FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
<FIELD NAME="thinkletid" TYPE="int" LENGTH="10" NOTNULL="true"/>
<FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
<FIELD NAME="timecompleted" TYPE="int" LENGTH="10" NOTNULL="true"/>
</FIELDS>
<KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
<INDEXES><INDEX NAME="thinklet-user" UNIQUE="true" FIELDS="thinkletid, userid"/></INDEXES>
</TABLE>
</TABLES>
</XMLDB>